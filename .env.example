# Base URL of the shop API (no trailing /api/v1). Server-side only — never exposed to the browser.
SHOP_API_URL=http://localhost:3000

# Encrypts the session cookie (≥ 32 characters). Generate one with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Optional: image origins that aren't https (dev MinIO signed links), comma-separated. Build-time.
# MEDIA_ORIGINS=http://localhost:9200

# Optional: read-only demo. Every change is refused (gateway and Server Actions) and a banner
# says so. DEMO_EMAIL / DEMO_PASSWORD are shown and prefilled on the sign-in page — use an admin
# whose role only has :read permissions, so the shop refuses changes too.
# DEMO_MODE=true
# DEMO_EMAIL=demo@example.com
# DEMO_PASSWORD=
